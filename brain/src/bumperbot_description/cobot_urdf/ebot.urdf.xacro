<?xml version="1.0"?>

<robot name="bumperbot" xmlns:xacro="http://ros.org/wiki/xacro">

  <!-- Start GZ or Ignition depending on ROS 2 Version -->
  <xacro:arg name="is_ignition" default="true"/>

  <!-- Load Simulated or Real Hardware Interfaces -->
  <xacro:arg name="is_sim" default="true"/>

  <!-- Include Gazebo Parameters -->

  <xacro:include filename="$(find bumperbot_description)/cobot_urdf/camera2.xacro" />


  <xacro:include filename="$(find bumperbot_description)/cobot_urdf/cobot_gazebo.xacro" />

  <!-- Include ros2_control Plugins -->
  <xacro:include filename="$(find bumperbot_description)/cobot_urdf/xarm_urdf.xacro" />


  <joint name="robot_connection_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_Link"/>
    <origin xyz="0.10 0 0" rpy="0 0 0"/>
  </joint>


    <xacro:property name="base_length" value="0.29" />
    <xacro:property name="base_width" value="0.29" />
    <xacro:property name="base_height" value="0.031" />
    <xacro:property name="wheel_radius" value="0.0516" />
    <xacro:property name="wheel_length" value="0.03" />

    <link name="base_footprint" />

    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0.0" rpy="0 0 0" />
        <mass value="2.5" />
        <inertia ixx="0.03556895833333333" ixy="0.0" ixz="0.0"
             iyy="0.03556895833333333" iyz="0.0"
             izz="0.052520833333333336" />
      </inertial>
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 0.0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
      <collision>
        <geometry>
          <box size="${base_length} ${base_width} ${base_height}" />
        </geometry>
        <origin xyz="0 0 0.0" rpy="0 0 0" />
      </collision>
    </link>

    <xacro:macro name="wheel_link" params="prefix">
        <link name="${prefix}_link">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0" />
          <mass value="0.2" />
          <inertia ixx="0.00019011333333333333" ixy="0.0" ixz="0.0"
               iyy="0.000266256" iyz="0.0"
               izz="0.00019011333333333333" />
        </inertial>
            <visual>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_length}" />
                </geometry>
                <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
                <material name="grey" />
            </visual>
        <collision>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_length}" />
          </geometry>
          <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0" />
        </collision>
        </link>
    </xacro:macro>

    <xacro:wheel_link prefix="wheel_right" />
    <xacro:wheel_link prefix="wheel_left" />

    <link name="caster_wheel_link">
      <inertial>
        <origin xyz="0 0 -0.0129" rpy="0 0 0" />
        <mass value="0.15" />
        <inertia ixx="9.0e-05" ixy="0.0" ixz="0.0"
             iyy="9.0e-05" iyz="0.0"
             izz="9.0e-05" />
      </inertial>
        <visual>
            <geometry>
                <sphere radius="0.0387" />
            </geometry>
            <origin xyz="0 0 -0.0129" rpy="0 0 0" />
            <material name="grey" />
        </visual>
      <collision>
        <geometry>
          <sphere radius="0.0387" />
        </geometry>
        <origin xyz="0 0 -0.0129" rpy="0 0 0" />
      </collision>
    </link>

    <joint name="base_joint" type="fixed">
        <parent link="base_footprint" />
        <child link="base_link" />
        <origin xyz="0 0 0.085" rpy="0 0 0"/>
    </joint>

    <joint name="wheel_right_joint" type="continuous">
        <parent link="base_link" />
        <child link="wheel_right_link" />
        <origin xyz="0.11 -0.17 -0.032" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="wheel_left_joint" type="continuous">
        <parent link="base_link" />
        <child link="wheel_left_link" />
        <origin xyz="0.11 0.17 -0.032" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <joint name="base_caster_wheel_joint" type="fixed">
        <parent link="base_link" />
        <child link="caster_wheel_link" />
        <origin xyz="-0.105 0 -0.04" rpy="0 0 0" />
    </joint>
    <link name="box_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.0" />
        <inertia ixx="0.006285416666666667" ixy="0.0" ixz="0.0"
             iyy="0.002183333333333333" iyz="0.0"
             izz="0.004994791666666666" />
      </inertial>
        <visual>
            <geometry>
                <box size="0.11 0.225 0.13" />
            </geometry>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <material name="blue" />
        </visual>
      <collision>
        <geometry>
          <box size="0.11 0.225 0.13" />
        </geometry>
        <origin xyz="0 0 0" rpy="0 0 0" />
      </collision>
    </link>
    <joint name="box_joint" type="fixed">
        <parent link="base_link" />
        <child link="box_link" />
        <origin xyz="-0.065 0 0.060" rpy="0 0 0" />
    </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="-0.00552433659106688 0.000168210391520346 0.000514000497342681" rpy="0 0 0" />
      <mass value="0.000528415362211671" />
      <inertia ixx="1.46176048428261E-08" ixy="1.40015117949421E-10" ixz="-1.99633872937403E-12"
               iyy="8.59662482954888E-09" iyz="7.52375112767959E-12"
               izz="2.30279421279312E-08" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/imu_link.STL" />
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/imu_link.STL" />
      </geometry>
    </collision>
  </link>
  
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.0698986241758014" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="imu_link" />
    <axis xyz="0 0 0" />
  </joint>

  <link name="laser_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.073084435549317" />
      <inertia ixx="1.96074931730795E-05" ixy="-3.62091076640009E-07" ixz="4.28230084046735E-07"
               iyy="2.40983835136327E-05" iyz="1.50180909250652E-08"
               izz="4.14184164228595E-05" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/laser_link.STL" />
      </geometry>
      <material name="dark_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://bumperbot_description/meshes/laser_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- STEP 9 - GPS -->
  <joint name="navsat_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <parent link="base_link"/>
      <child link="navsat_link" />
  </joint>

  <link name="navsat_link">
  </link>

  <material name="blue">
    <color rgba="0 0 1 1"/>
  </material>
  <material name="black">
    <color rgba="0 0 0 1"/>
  </material>
  <material name="silver">
    <color rgba="0.79 0.82 0.93 1"/>
  </material>
  <material name="dark_grey">
    <color rgba="0.3 0.3 0.3 1"/>
  </material>  

  <joint name="laser_joint" type="fixed">
    <origin xyz="-0.065 0 0.165" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="laser_link" />
    <axis xyz="0 0 0" />
  </joint>

</robot>